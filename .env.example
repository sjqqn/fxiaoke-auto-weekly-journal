# 需要生成周日志的人员（逗号分隔，支持多人）
OWNER_NAMES=沈佳琪

# 点评人（逗号分隔；写入日志的 multi_comment_by 字段，默认安春晖yak）
REVIEWER_NAMES=安春晖yak

# 纷享销客 MCP 服务器
MCP_BASE_URL=https://open.fxiaoke.com/mcp/fs/crm-mcp
MCP_TOKEN=FSUTK_xxx   # 从 ~/.cursor/mcp.json 的 Authorization 字段复制

# LLM 配置（可选；当前模板渲染不依赖 LLM，留作扩展）
# MiniMax
MINIMAX_API_KEY=       # 从 https://platform.minimaxi.com 获取
# OpenAI（没有 MiniMax 时用）
OPENAI_API_KEY=

# 模型名（可选，不填则自动选默认值）
# MiniMax 默认：MiniMax-Text-01
# OpenAI  默认：gpt-4o
LLM_MODEL=

# 调试用（可选）：覆盖统计截止时间，格式 2026-05-02T19:00:00+08:00
OVERRIDE_END_TIME=
